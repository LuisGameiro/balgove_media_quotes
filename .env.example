# Local development defaults for Docker Compose, Dagster, and Python Settings.
# Copy to .env for local use: PowerShell: Copy-Item .env.example .env
# These are local-only credentials. Replace them for any shared deployment.

# ------------------------------------------------------------------------------
# 1. Database & Docker Compose
# ------------------------------------------------------------------------------
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news

# SQLAlchemy URL used by Python settings (matches the local Compose service).
# 127.0.0.1 avoids IPv6 localhost resolution delays on Windows.
DATABASE_URL=postgresql+psycopg://news:news@127.0.0.1:5432/news
PERSIST_TO_POSTGRES=false

# ------------------------------------------------------------------------------
# 2. Dagster Orchestration
# ------------------------------------------------------------------------------
# An absolute path is recommended in .env; a relative path such as var/dagster resolves from the
# project root. scripts/run_dagster.ps1 sets an absolute path automatically.
# Example: DAGSTER_HOME=C:/Users/you/path/to/balgoveinnovations/var/dagster
# DAGSTER_HOME=var/dagster

# Required to view the Streamlit dashboard: set a password before any deployment.
DASHBOARD_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Logging & OpenTelemetry Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
# OTLP/HTTP collector provided by docker-compose.yml; enable tracing to emit spans.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# ------------------------------------------------------------------------------
# 4. LLM / OpenRouter Section Inference
# ------------------------------------------------------------------------------
# Inference provider. There is no CLI flag.
# local: deterministic, offline section inferences.
# openrouter: live section inferences through OpenRouter's OpenAI-compatible API.
LLM_PROVIDER=local

# Must be an explicit model id, not unset/latest, when using OpenRouter.
LLM_MODEL_SNAPSHOT=unset
PROMPT_VERSION=standalone-inference-v1

# Required when LLM_PROVIDER=openrouter. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/LuisGameiro/balgove_media_quotes
OPENROUTER_APP_TITLE=Media Quotes Collection System
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 5. Pipeline Window, Evaluation & Rights Limits
# ------------------------------------------------------------------------------
# Optional date override (YYYY-MM-DD); normally passed via --date on the CLI.
# REPORT_DATE=2026-11-19
BACKFILL_START=2026-10-01
REPORT_WINDOW_DAYS=14
GOLD_SET_VERSION=synthetic-v1
MAX_QUOTE_WORDS=30
ATTRIBUTION_FORMAT=Outlet — Named person (role), Article, YYYY-MM-DD, URL
LICENCE_TERRITORY=internal worldwide

# ------------------------------------------------------------------------------
# 6. Project Paths (resolved relative to project root)
# ------------------------------------------------------------------------------
# One root for all generated artifacts: digests/, raw/, audit/, quotes/, logs/.
# Leave the five *_DIR overrides unset to use this single root.
OUTPUT_DIR=var/output
SOURCES_CSV=data/sources.csv
SECTIONS_CSV=data/sections.csv
SCHEMA_PATH=data/quotes.schema.json
FIXTURES_DIR=data/fixtures
GOLD_SET_DIR=data/gold_set
ALEMBIC_INI=alembic.ini
# Optional overrides (only set these to split artifacts across folders):
# DIGEST_DIR=var/output/digests
# BLOB_DIR=var/output/raw
# AUDIT_DIR=var/output/audit
# EXPORT_DIR=var/output/quotes
# LOGS_DIR=var/output/logs

# ------------------------------------------------------------------------------
# 7. Topic Packs and Modular Source Config
# ------------------------------------------------------------------------------
# Active topic pack from data/topics/<id>.json. Override per run with --topic.
ACTIVE_TOPIC=ukraine-war
SOURCES_DIR=data/sources
SOURCE_TOPICS_CSV=data/source_topic_routes.csv
TOPIC_RULES_PATH=data/topic_rules.json
TOPICS_DIR=data/topics

# ------------------------------------------------------------------------------
# 8. Optional workstreams (off by default)
# ------------------------------------------------------------------------------
# Translation: off | detect_only | translate.
# TRANSLATION_MODE=translate requires LLM_PROVIDER=openrouter, a pinned
# LLM_MODEL_SNAPSHOT, and a source route with translation_rights_confirmed=true.
TRANSLATION_MODE=off
TRANSLATION_PROMPT_VERSION=translation-v1

# AI judge: off | shadow | advisory | decision.
# Every mode except off requires LLM_PROVIDER=openrouter, OPENROUTER_API_KEY and a
# pinned AI_JUDGE_MODEL_SNAPSHOT (never unset/latest).
AI_JUDGE_MODE=off
AI_JUDGE_MODEL_SNAPSHOT=unset
JUDGE_PROMPT_VERSION=judge-v1

# Second-pass extraction when the strict quality gate rejects the first pass.
# off (default) | static (recall-favouring trafilatura) | rendered (optional Playwright).
# rendered needs the optional render group: uv sync --group render (add --group dev as needed).
# rendered is disabled unless the source has extractor_hints.render_js=true and is rights-cleared.
EXTRACTION_FALLBACK=off

# Batch backfill (opt-in; CLI requires an explicit --max-cost).
# Must be a pinned, batch-enabled model id; empty disables batch submission.
BATCH_MODEL_SNAPSHOT=
BATCH_ENDPOINT=/v1/responses

# ------------------------------------------------------------------------------
# 9. Live fetch policy (used by scripts/test_scraper.py and mq fetch)
# ------------------------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=10
FETCH_REQUESTS_PER_SECOND=1
FETCH_MAX_BYTES=5000000
FETCH_MAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# 10. Optional Neo4j graph projection (off by default)
# ------------------------------------------------------------------------------
SYNC_TO_NEO4J=false
# Compose uses NEO4J_USER/NEO4J_PASSWORD below for NEO4J_AUTH.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
