# Copy to .env and adjust. No secrets are committed.
DATABASE_URL=postgresql+psycopg://news:news@localhost:5432/news
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Paths for derived artifacts
DIGEST_DIR=digests
BLOB_DIR=var/blobs

# LLM pinning (set when T4 is implemented)
LLM_MODEL_SNAPSHOT=unset
