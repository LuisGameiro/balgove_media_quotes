# Local development defaults for Docker Compose and Settings.
# Copy to .env for local use: PowerShell: Copy-Item .env.example .env
# These are local-only credentials. Replace them for any shared deployment.
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news

# SQLAlchemy URL used by Python settings (matches the local Compose service).
# 127.0.0.1 avoids IPv6 localhost resolution delays on Windows.
DATABASE_URL=postgresql+psycopg://news:news@127.0.0.1:5432/news

LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false

# Inference provider. There is no CLI flag.
# local: deterministic, offline section inferences.
# openrouter: live section inferences through OpenRouter's OpenAI-compatible API.
LLM_PROVIDER=local

# Required when LLM_PROVIDER=openrouter.
# Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Must be an explicit model id, not unset/latest, when using OpenRouter.
LLM_MODEL_SNAPSHOT=unset

OPENROUTER_APP_URL=https://github.com/balgoveinnovations/media-quotes
OPENROUTER_APP_TITLE=Media Quotes Collection System
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
